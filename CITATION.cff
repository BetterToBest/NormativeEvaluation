    given-names: Duke
    affiliation: "Independent researcher"
  - name: "Claude (Anthropic)"
version: "2.0-dev"
license: CC-BY-4.0
repository-code: "https://github.com/BetterToBest/NormativeEvaluation"
url: "https://sites.google.com/view/normativeeconomicevaluation/home"
keywords:

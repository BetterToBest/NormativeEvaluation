{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bettertobest.github.io/NormativeEvaluation/schemas/criteria_schema.json",
  "title": "NEEC criteria (neec-criteria/2.0)",
  "description": "The 29 criteria of the NEEC v2.0 structure with their definitions, clauses, revision class and 1.0 / 0.5 / 0.0 anchors. Generated by build_criteria.py (version 2.1) from criteria_s44_snapshot.json and Appendix V of NEEC_Criteria_v2_s45.md; do not edit by hand. The neec-criteria/1.0 schema is pinned as criteria_schema_s44_snapshot.json.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "framework",
    "generated_by",
    "source",
    "scale",
    "structure",
    "tiers",
    "domains",
    "classes",
    "criteria"
  ],
  "$defs": {
    "criterion_id": {
      "type": "string",
      "pattern": "^C(1\\.(1|2a|2b|[3-9])|[2-5]\\.[1-9])$"
    },
    "band": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "examples"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "examples": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "system",
              "cited"
            ],
            "properties": {
              "system": {
                "type": "string"
              },
              "cited": {
                "enum": [
                  0.0,
                  0.5,
                  1.0
                ]
              }
            }
          }
        },
        "corrections": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Open corrections: an example whose cited band disagrees with the published score. Do not use it as an exemplar."
        }
      }
    }
  },
  "properties": {
    "schema": {
      "const": "neec-criteria/2.0"
    },
    "framework": {
      "type": "string"
    },
    "generated_by": {
      "type": "string"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base",
        "base_md5",
        "record",
        "record_md5",
        "clause_splits",
        "v1"
      ],
      "properties": {
        "base": {
          "type": "string"
        },
        "base_md5": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "record": {
          "type": "string"
        },
        "record_md5": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "clause_splits": {
          "type": "string"
        },
        "v1": {
          "type": "object",
          "required": [
            "document",
            "md5",
            "excluded_fields",
            "removed_comparative_clauses"
          ],
          "properties": {
            "document": {
              "type": "string"
            },
            "md5": {
              "type": "string",
              "pattern": "^[0-9a-f]{32}$"
            },
            "excluded_fields": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "removed_comparative_clauses": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "criterion",
                  "clause"
                ]
              }
            }
          },
          "description": "The source block of neec-criteria/1.0 (Paper v1.4), carried unchanged."
        }
      }
    },
    "scale": {
      "type": "object",
      "required": [
        "values",
        "labels",
        "rule"
      ]
    },
    "structure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "criteria",
        "total_max",
        "domain_max",
        "tiers_note"
      ],
      "properties": {
        "criteria": {
          "type": "integer",
          "minimum": 28
        },
        "total_max": {
          "type": "number",
          "minimum": 28
        },
        "domain_max": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "D1",
            "D2",
            "D3",
            "D4",
            "D5"
          ],
          "properties": {
            "D1": {
              "type": "number"
            },
            "D2": {
              "type": "number"
            },
            "D3": {
              "type": "number"
            },
            "D4": {
              "type": "number"
            },
            "D5": {
              "type": "number"
            }
          }
        },
        "tiers_note": {
          "type": "string"
        }
      },
      "description": "The exact structure is the one the record's Appendix V states; build_criteria.py asserts it (A7)."
    },
    "tiers": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": [
          "name",
          "failures_min",
          "failures_max"
        ]
      }
    },
    "domains": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "core_question",
          "criteria"
        ],
        "properties": {
          "id": {
            "enum": [
              "D1",
              "D2",
              "D3",
              "D4",
              "D5"
            ]
          },
          "name": {
            "type": "string"
          },
          "core_question": {
            "type": "string"
          },
          "criteria": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/criterion_id"
            }
          }
        }
      }
    },
    "criteria": {
      "type": "array",
      "minItems": 29,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "domain",
          "name",
          "definition",
          "anchors",
          "sources",
          "revision"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/criterion_id"
          },
          "domain": {
            "enum": [
              "D1",
              "D2",
              "D3",
              "D4",
              "D5"
            ]
          },
          "name": {
            "type": "string"
          },
          "definition": {
            "type": "object",
            "required": [
              "derivation",
              "requirement",
              "pass_threshold",
              "clauses"
            ],
            "properties": {
              "clauses": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "description": "The Pass Threshold's clauses, each a verbatim substring of it, in order (decision D28; protocol Appendix B)."
              },
              "clause_scope": {
                "type": "string",
                "description": "Text of the Pass Threshold that applies to every clause."
              }
            },
            "additionalProperties": {
              "type": "string"
            }
          },
          "anchors": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "threshold",
              "note",
              "bands"
            ],
            "properties": {
              "threshold": {
                "type": "string"
              },
              "note": {
                "type": "string"
              },
              "bands": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "1.0",
                  "0.5",
                  "0.0"
                ],
                "properties": {
                  "1.0": {
                    "$ref": "#/$defs/band"
                  },
                  "0.5": {
                    "$ref": "#/$defs/band"
                  },
                  "0.0": {
                    "$ref": "#/$defs/band"
                  }
                }
              }
            }
          },
          "sources": {
            "type": "object",
            "required": [
              "definition",
              "anchors"
            ],
            "properties": {
              "definition": {
                "type": "string"
              },
              "anchors": {
                "type": "string"
              },
              "threshold": {
                "type": "string"
              }
            }
          },
          "revision": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "cls",
              "codes"
            ],
            "properties": {
              "cls": {
                "enum": [
                  "W",
                  "D",
                  "I",
                  "M",
                  "N",
                  "U"
                ]
              },
              "codes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "description": "The criterion's v2.0 revision class and the review codes behind it."
          }
        }
      }
    },
    "classes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "W",
        "D",
        "I",
        "M",
        "N",
        "U"
      ],
      "properties": {
        "W": {
          "type": "string"
        },
        "D": {
          "type": "string"
        },
        "I": {
          "type": "string"
        },
        "M": {
          "type": "string"
        },
        "N": {
          "type": "string"
        },
        "U": {
          "type": "string"
        }
      },
      "description": "The revision classes of decision 45.2 (NEEC_Criteria_v2_s45.md, section 2): what the rescoring pass must re-check."
    }
  }
}

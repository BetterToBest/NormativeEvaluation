{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bettertobest.github.io/NormativeEvaluation/schemas/criteria_schema.json",
  "title": "NEEC criteria (neec-criteria/1.0)",
  "description": "The 26 criteria of the NEEC v2 structure with their definitions and 1.0 / 0.5 / 0.0 anchors. Generated by build_criteria.py from the Paper; do not edit by hand.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "framework", "generated_by", "source", "scale", "structure", "tiers", "domains", "criteria"],
  "$defs": {
    "criterion_id": {"type": "string", "pattern": "^C(1\\.(1|2a|2b|3|4|5)|[2-5]\\.[1-5])$"},
    "band": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "examples"],
      "properties": {
        "text": {"type": "string", "minLength": 1},
        "examples": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["system", "cited"],
            "properties": {"system": {"type": "string"}, "cited": {"enum": [0.0, 0.5, 1.0]}}
          }
        },
        "corrections": {"type": "array", "items": {"type": "string"}, "description": "Open corrections: an example whose cited band disagrees with the published score. Do not use it as an exemplar."}
      }
    }
  },
  "properties": {
    "schema": {"const": "neec-criteria/1.0"},
    "framework": {"type": "string"},
    "generated_by": {"type": "string"},
    "source": {
      "type": "object",
      "required": ["document", "md5", "excluded_fields", "removed_comparative_clauses"],
      "properties": {
        "document": {"type": "string"},
        "md5": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
        "excluded_fields": {"type": "array", "items": {"type": "string"}},
        "removed_comparative_clauses": {"type": "array", "items": {"type": "object", "required": ["criterion", "clause"]}}
      }
    },
    "scale": {"type": "object", "required": ["values", "labels", "rule"]},
    "structure": {"type": "object", "required": ["criteria", "total_max", "domain_max"]},
    "tiers": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": {"type": "object", "required": ["name", "failures_min", "failures_max"]}
    },
    "domains": {
      "type": "array", "minItems": 5, "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "core_question", "criteria"],
        "properties": {
          "id": {"enum": ["D1", "D2", "D3", "D4", "D5"]},
          "name": {"type": "string"},
          "core_question": {"type": "string"},
          "criteria": {"type": "array", "items": {"$ref": "#/$defs/criterion_id"}}
        }
      }
    },
    "criteria": {
      "type": "array", "minItems": 26, "maxItems": 26,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "domain", "name", "definition", "anchors", "sources"],
        "properties": {
          "id": {"$ref": "#/$defs/criterion_id"},
          "domain": {"enum": ["D1", "D2", "D3", "D4", "D5"]},
          "name": {"type": "string"},
          "definition": {
            "type": "object",
            "required": ["derivation", "requirement", "pass_threshold"],
            "additionalProperties": {"type": "string"}
          },
          "anchors": {
            "type": "object",
            "additionalProperties": false,
            "required": ["threshold", "note", "bands"],
            "properties": {
              "threshold": {"type": "string"},
              "note": {"type": "string"},
              "bands": {
                "type": "object",
                "additionalProperties": false,
                "required": ["1.0", "0.5", "0.0"],
                "properties": {"1.0": {"$ref": "#/$defs/band"}, "0.5": {"$ref": "#/$defs/band"}, "0.0": {"$ref": "#/$defs/band"}}
              }
            }
          },
          "sources": {
            "type": "object",
            "required": ["definition", "anchors"],
            "properties": {"definition": {"type": "string"}, "anchors": {"type": "string"}}
          }
        }
      }
    }
  }
}
